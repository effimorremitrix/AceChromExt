{
  "manifest_version": 3,
  "name": "Quickfill Helper",
  "version": "0.1.0",
  "description": "Paste a carrier email, a filing package or spreadsheet rows, and fill the ACE or INTTRA screen in front of you. No preview, no checks. You review and submit.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Quickfill Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://ace.cbp.dhs.gov/*",
    "https://aesdirect.cbp.dhs.gov/*",
    "https://*.cbp.dhs.gov/*",
    "https://*.inttra.com/*",
    "https://*.e2open.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ace.cbp.dhs.gov/*",
        "https://aesdirect.cbp.dhs.gov/*",
        "https://*.cbp.dhs.gov/*",
        "https://*.inttra.com/*",
        "https://*.e2open.com/*"
      ],
      "js": [
        "quickfillContent.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
